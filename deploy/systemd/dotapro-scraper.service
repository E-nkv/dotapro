[Unit]
Description=Dotapro Scraper (one-shot)
After=network-online.target dotapro-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/dotapro
EnvironmentFile=/opt/dotapro/.env
ExecStart=/opt/dotapro/bin/scraper
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/dotapro/data
ProtectHome=true
PrivateTmp=true
